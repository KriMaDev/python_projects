# Copy this file to .env and fill in your own keys. Never commit .env.
# Free keys: https://openweathermap.org/api, https://www.weatherapi.com, https://weatherstack.com
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=
WEATHERSTACK_API_KEY=

# Weatherstack's free plan only supports HTTP. Set to 1 if your plan supports HTTPS.
WEATHERSTACK_HTTPS=0
