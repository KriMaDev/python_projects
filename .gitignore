.env
.env.*
*.env
!.env.example
key_consts.py
secrets.*
*secret*.json
credentials*.json
service-account*.json
token.json
.netrc
.pypirc

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk

